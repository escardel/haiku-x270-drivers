resource app_signature "application/x-vnd.DisplayColor";
resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;
resource app_version {
	major = 1,
	middle = 1,
	minor = 1,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Display Color",
	long_info = "Contrast, gamma, RGB saturation and scheduled blue light filter for Haiku"
};
