+static uint8
+clickpad_buttons(synaptics_cookie* cookie, const uint8* packet)
+{
+	if (((packet[0] ^ packet[3]) & 1) == 0) {
+		cookie->clickpad_button = 0;
+		return 0;
+	}
+
+	if (cookie->clickpad_button == 0) {
+		uint32 x = packet[4] | ((packet[1] & 0x0f) << 8)
+			| ((packet[3] & 0x10) << 8);
+		uint32 y = packet[5] | ((packet[1] & 0xf0) << 4)
+			| ((packet[3] & 0x20) << 7);
+		uint32 rightStart = gHardwareSpecs.areaStartX
+			+ (gHardwareSpecs.areaEndX - gHardwareSpecs.areaStartX) / 2;
+		uint32 bottomEnd = gHardwareSpecs.areaStartY
+			+ (gHardwareSpecs.areaEndY - gHardwareSpecs.areaStartY) / 5;
+
+		// Latch the clickpad switch before merging the TrackPoint buttons.
+		// Dragging out of a button area must not change the held button.
+		cookie->clickpad_button = x >= rightStart && y > 0 && y <= bottomEnd
+			? 2 : 1;
+		static uint32 presses = 0;
+		if (++presses <= 8) {
+			INFO("X270_CLICKPAD: button=%u x=%lu y=%lu\n",
+				cookie->clickpad_button, (unsigned long)x, (unsigned long)y);
+		}
+	}
+	return cookie->clickpad_button;
+}
