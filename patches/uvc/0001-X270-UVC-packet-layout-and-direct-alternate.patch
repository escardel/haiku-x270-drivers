From bbf32f7816bd7c3135938611abfa2a8bfc5ced13 Mon Sep 17 00:00:00 2001
From: X270-Development <x270-local@invalid>
Date: Thu, 22 Oct 2026 17:23:06 -0700
Subject: [PATCH 1/2] X270-UVC-packet-layout-and-direct-alternate

---
 CamDevice.cpp               | 17 +++++++------
 Producer.cpp                |  6 ++++-
 addons/uvc/UVCCamDevice.cpp | 49 +++----------------------------------
 3 files changed, 18 insertions(+), 54 deletions(-)

diff --git a/CamDevice.cpp b/CamDevice.cpp
index c1005cf..3feb635 100644
--- a/CamDevice.cpp
+++ b/CamDevice.cpp
@@ -1153,7 +1153,7 @@ CamDevice::DataPumpThread()
 		// USB 2.0 HS rate, well below a 30 fps frame interval (~33 ms).
 		// A proper fix requires queueing multiple transfers in the kernel.
 
-		const int kMaxPacketDescriptors = 64;  // Array size (max possible)
+		const int kMaxPacketDescriptors = 64;
 		const int kMinPacketDescriptors = 2;   // Minimum viable
 		usb_iso_packet_descriptor packetDescriptors[kMaxPacketDescriptors];
 
@@ -1209,7 +1209,8 @@ CamDevice::DataPumpThread()
 				// The deframer handles incomplete frames with its own validation
 
 				// Isochronous transfer
-				len = fIsoIn->IsochronousTransfer(fBuffer, fBufferLen,
+				len = fIsoIn->IsochronousTransfer(fBuffer,
+					packetSize * numPacketDescriptors,
 					packetDescriptors, numPacketDescriptors);
 			}
 			// Lock released here - processing happens unlocked
@@ -1305,11 +1306,11 @@ CamDevice::DataPumpThread()
 				// PHASE 4 FIX: Use fixed packet offsets (not sequential)
 				// EHCI places data at packet_index * request_length
 
-				// CRITICAL FIX: EHCI kernel calculates slot size as DataLength/packet_count
-				// We must ensure: fBufferLen = slotSize * numPacketDescriptors
-				// So: slotSize = fBufferLen / numPacketDescriptors
-				// This MUST match request_length if buffer was properly sized
-				size_t slotSize = fBufferLen / numPacketDescriptors;
+				// The transfer above submits only packetSize * numPacketDescriptors
+				// bytes of the larger allocated buffer. The USB stack lays packet
+				// data out at that submitted length divided by packet count.
+				const size_t transferSize = packetSize * numPacketDescriptors;
+				const size_t slotSize = transferSize / numPacketDescriptors;
 
 				// Verify alignment and log packet info (first few times)
 				static int logCount = 0;
@@ -1349,7 +1350,7 @@ CamDevice::DataPumpThread()
 				int actual_length = packetDescriptors[i].actual_length;
 
 				// Bounds check
-				if (actual_length > 0 && packetOffset + actual_length <= fBufferLen) {
+					if (actual_length > 0 && packetOffset + actual_length <= transferSize) {
 					fDataInput->Write(&fBuffer[packetOffset], actual_length);
 					packetSuccess++;
 				}
diff --git a/Producer.cpp b/Producer.cpp
